# GotYourScore environment configuration (template).
# Copy to .env and adjust values. NEVER commit the real .env file.

PROJECT_NAME=GotYourScore
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gotyourscore


OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth allowed email domain for the internal support team
ALLOWED_DOMAIN=example.com

# Global QA quota: 6 cases per support agent per month
MONTHLY_QUOTA=6

# Session cookie signing secret (override with a strong random value in production)
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false
# Session lifetime in seconds (12 hours by default).
SESSION_MAX_AGE=43200

# Per-user AI budget: 20 requests / 5 minutes, no more than 2 in flight.
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=300
AI_MAX_CONCURRENT_REQUESTS_PER_USER=2
